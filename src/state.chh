#!/usr/bin/chippy
#
# dfn-mounter - state.chh
#

var mounterDevices = [];
var mounterSelectedIndex = 1;
var mounterScrollOffset = 1;
var mounterScreenWidth = MINTERMWIDTH;
var mounterScreenHeight = MINTERMHEIGHT;

var mounterWinsizeHandle = err;
var mounterInDialog = false;

var mounterShowKeybinds = false;

var mounterSkipFullRedraw = false;

#@ <SelectedDevice()>
#@ Returns the currently selected device entry, or ''err'' if the current selection
#@ is not valid. A valid selection is an in-range index pointing at a real device
#@ and not a section header.

func SelectedDevice()
{
	if mounterSelectedIndex < 1 or mounterSelectedIndex > len(mounterDevices)
	{
		return err;
	}

	var dev = mounterDevices[mounterSelectedIndex];

	if not IsDeviceEntry(dev) { return err; }

	return dev;
}

#@ <SnapToDevice(start, direction)>
#@ Returns the nearest index that points at a real device and not a section header.
#@ Tries ''direction'' first (''1'' = forward, ''-1'' = backward). Falls back to the
#@ opposite direction if no device is found.

func SnapToDevice(start, direction)
{
	if len(mounterDevices) == 0 { return 1; }

	var idx = start;

	while idx >= 1 and idx <= len(mounterDevices)
	{
		if IsDeviceEntry(mounterDevices[idx]) { return idx; }

		idx = idx + direction;
	}

	var opposite = -direction;

	idx = start;

	while idx >= 1 and idx <= len(mounterDevices)
	{
		if IsDeviceEntry(mounterDevices[idx]) { return idx; }

		idx = idx + opposite;
	}

	return start;
}

#@ <MoveSelection(delta)>
#@ Moves the selection by ''delta''. Clamps to the list and skips section headers
#@ in the direction of travel.

func MoveSelection(delta)
{
	if len(mounterDevices) == 0 { return; }

	var newIdx = mounterSelectedIndex + delta;

	if newIdx < 1 { newIdx = 1; }
	if newIdx > len(mounterDevices) { newIdx = len(mounterDevices); }

	var direction = 1;

	if delta < 0 { direction = -1; }

	mounterSelectedIndex = SnapToDevice(newIdx, direction);

	MounterAdjustScroll();
}

#@ <MounterRefreshDevices()>
#@ Reloads the device list and rebuilds the sectionized view.

func MounterRefreshDevices()
{
	# Remember the selected device by name so the cursor follows it even when
	# the list reshapes.
	var prevName = "";
	var prevSel = SelectedDevice();

	if not iserr(prevSel) { prevName = prevSel["name"]; }

	mounterDevices = SectionizedDevices(LoadDevices());

	var restored = false;

	if prevName != ""
	{
		for i = 1 to len(mounterDevices)
		{
			var entry = mounterDevices[i];

			if IsDeviceEntry(entry) and entry["name"] == prevName
			{
				mounterSelectedIndex = i;
				restored = true;

				break;
			}
		}
	}

	# Previously selected device is gone, clamp the stale index and snap to the
	# nearest real entry.
	if not restored
	{
		if mounterSelectedIndex > len(mounterDevices)
		{
			mounterSelectedIndex = len(mounterDevices);
		}

		if mounterSelectedIndex < 1 { mounterSelectedIndex = 1; }

		mounterSelectedIndex = SnapToDevice(mounterSelectedIndex, 1);
	}

	MounterAdjustScroll();
}

#@ <MounterUpdateScreenSize()>
#@ Reads the current terminal size into the screen-dimension globals.

func MounterUpdateScreenSize()
{
	var size = winsize();

	if iserr(size) { return; }

	mounterScreenHeight = size["rows"];
	mounterScreenWidth = size["columns"];
}

#@ <GetVisibleDeviceCount()>
#@ Returns how many device rows can be displayed at once.

func GetVisibleDeviceCount()
{
	var region = GetMounterListRegion();

	return int(region[5] / FILEROWHEIGHT);
}

#@ <MounterAdjustScroll()>
#@ Adjusts scroll offset to keep selection visible.

func MounterAdjustScroll()
{
	var visibleDevices = GetVisibleDeviceCount();

	if mounterSelectedIndex < mounterScrollOffset
	{
		mounterScrollOffset = mounterSelectedIndex;
	}

	if mounterSelectedIndex >= mounterScrollOffset + visibleDevices
	{
		mounterScrollOffset = mounterSelectedIndex - visibleDevices + 1;
	}

	# Avoid empty rows below the last device when devices fit the viewport.
	var maxOffset = len(mounterDevices) - visibleDevices + 1;

	if maxOffset < 1 { maxOffset = 1; }
	if mounterScrollOffset > maxOffset { mounterScrollOffset = maxOffset; }
	if mounterScrollOffset < 1 { mounterScrollOffset = 1; }

	# If a section header sits just above the viewport, scroll up so it stays
	# visible. Otherwise the selected device shows without its section label.
	# Stop once scrolling further up would push the selection off the bottom.
	while mounterScrollOffset > 1 and not IsDeviceEntry(mounterDevices[mounterScrollOffset - 1])
	{
		if mounterSelectedIndex > mounterScrollOffset + visibleDevices - 2
		{
			break;
		}

		mounterScrollOffset = mounterScrollOffset - 1;
	}
}

#@ <MounterCurrentState()>
#@ Packs the render-relevant globals into a single map for MounterWinChActor().

func MounterCurrentState()
{
	return m[
		"devices": mounterDevices,
		"selectedIndex": mounterSelectedIndex,
		"scrollOffset": mounterScrollOffset,
		"showKeybinds": mounterShowKeybinds,
		"inDialog": mounterInDialog
	];
}

#@ <EnterMounterDialog()>
#@ Sets the in-dialog flag and tells the winsize actor to suppress repaints
#@ until the dialog returns.

func EnterMounterDialog()
{
	mounterInDialog = true;

	if not iserr(mounterWinsizeHandle)
	{
		send(mounterWinsizeHandle, MounterCurrentState());
	}
}

#@ <ExitMounterDialog()>
#@ Clears the in-dialog flag.

func ExitMounterDialog()
{
	mounterInDialog = false;

	if not iserr(mounterWinsizeHandle)
	{
		send(mounterWinsizeHandle, MounterCurrentState());
	}
}

#@ <MounterWinChActor()>
#@ Actor for detecting and acting :D on window size changes

func MounterWinChActor()
{
	sigcatch([SIGWINCH]);

	var state = m[];

	while true
	{
		signal();

		var msgs = receive(false);

		if len(msgs) > 0 { state = msgs[len(msgs)]; }

		if len(state) == 0 { continue; }

		if state["inDialog"] { continue; }

		var size = winsize();

		if iserr(size) { continue; }

		mounterScreenHeight = size["rows"];
		mounterScreenWidth = size["columns"];

		if mounterScreenWidth < MINTERMWIDTH or mounterScreenHeight < MINTERMHEIGHT
		{
			continue;
		}

		mounterDevices = state["devices"];
		mounterSelectedIndex = state["selectedIndex"];
		mounterScrollOffset = state["scrollOffset"];
		mounterShowKeybinds = state["showKeybinds"];

		MounterAdjustScroll();

		ClearScreen();

		MounterDrawScreen();
	}
}
