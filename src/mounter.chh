#!/usr/bin/chippy
#
# dfn-mounter - mounter.chh
#

#@ <MounterUpdateScreenSize()>
#@ Reads the current terminal size into the state.

func MounterUpdateScreenSize()
{
	var size = winsize();

	if iserr(size) { return; }

	mounterScreenHeight = size["rows"];
	mounterScreenWidth = size["columns"];
}

#@ <MounterCurrentState()>
#@ Packs the relevant rendering state values into a single map for MounterWinChActor().

func MounterCurrentState()
{
	return m[
		"devices": mounterDevices,
		"disks": mounterDisks,
		"selectedDisk": mounterSelectedDisk,
		"diskScrollOffset": mounterDiskScrollOffset,
		"activeDisk": mounterActiveDisk,
		"volumes": mounterVolumes,
		"selectedIndex": mounterSelectedIndex,
		"scrollOffset": mounterScrollOffset,
		"focusPanel": mounterFocusPanel,
		"showKeybinds": mounterShowKeybinds,
		"inDialog": mounterInDialog
	];
}

#@ <MounterWinChActor()>
#@ Actor for detecting and acting :D on window size changes

func MounterWinChActor()
{
	sigcatch([SIGWINCH]);

	var state = m[];

	while true
	{
		signal();

		var msgs = receive(false);

		if len(msgs) > 0 { state = msgs[len(msgs)]; }

		if len(state) == 0 { continue; }

		if state["inDialog"] { continue; }

		var size = winsize();

		if iserr(size) { continue; }

		mounterScreenHeight = size["rows"];
		mounterScreenWidth = size["columns"];

		if mounterScreenWidth < MINTERMWIDTH or mounterScreenHeight < MINTERMHEIGHT
		{
			continue;
		}

		# Re-clamp against the new viewport before drawing.
		mounterDevices = state["devices"];
		mounterDisks = state["disks"];
		mounterSelectedDisk = state["selectedDisk"];
		mounterDiskScrollOffset = state["diskScrollOffset"];
		mounterActiveDisk = state["activeDisk"];
		mounterVolumes = state["volumes"];
		mounterSelectedIndex = state["selectedIndex"];
		mounterScrollOffset = state["scrollOffset"];
		mounterFocusPanel = state["focusPanel"];
		mounterShowKeybinds = state["showKeybinds"];

		MounterAdjustDiskScroll();
		MounterAdjustScroll();

		ClearScreen();

		MounterDrawScreen();
	}
}

#@ <MounterHandleSidebarInput(key)>
#@ Handles a ''key'' press while the disk sidebar has focus.

func MounterHandleSidebarInput(key)
{
	if key == BFKEYENTER or key == BFKEYRIGHT
	{
		var disk = SelectedDisk();

		if not iserr(disk)
		{
			NavigateToDisk(disk);

			mounterFocusPanel = FOCUSVOLUMES;
		}
	}
	elseif key == BFKEYUP
	{
		MoveDiskSelection(-1);
	}
	elseif key == BFKEYDOWN
	{
		MoveDiskSelection(1);
	}
	elseif key == BFKEYHOME or key == BFKEYPAGEUP
	{
		MoveDiskSelection(-len(mounterDisks));
	}
	elseif key == BFKEYEND or key == BFKEYPAGEDOWN
	{
		MoveDiskSelection(len(mounterDisks));
	}
	elseif key == KEYI or key == KEYII
	{
		ActionShowDiskInfoSelected();
	}
	elseif key == KEYE or key == KEYEE
	{
		ActionEjectSelectedDisk();
	}
}

#@ <MounterHandleVolumeInput(key)>
#@ Handles a ''key'' press while the volume list has focus.

func MounterHandleVolumeInput(key)
{
	var pageSize = GetVisibleVolumeCount();

	if key == BFKEYENTER or key == BFKEYRIGHT
	{
		var volume = SelectedVolume();

		if not iserr(volume)
		{
			if IsLuks(volume) and not IsLuksUnlocked(volume, mounterDevices)
			{
				ActionUnlockSelected();
			}
			elseif not IsMounted(volume)
			{
				ActionMountSelected();
			}
			else
			{
				ActionOpenInDfn();
			}
		}
	}
	elseif key == BFKEYLEFT
	{
		var volume = SelectedVolume();

		if not iserr(volume)
		{
			if IsLuks(volume) and IsLuksUnlocked(volume, mounterDevices)
			{
				ActionLockSelected();
			}
			elseif IsMounted(volume)
			{
				ActionUnmountSelected();
			}
		}
	}
	elseif key == BFKEYUP
	{
		MoveSelectionRedraw(-1);
	}
	elseif key == BFKEYDOWN
	{
		MoveSelectionRedraw(1);
	}
	elseif key == BFKEYPAGEUP
	{
		MoveSelection(-pageSize);
	}
	elseif key == BFKEYPAGEDOWN
	{
		MoveSelection(pageSize);
	}
	elseif key == BFKEYHOME
	{
		MoveSelection(-len(mounterVolumes));
	}
	elseif key == BFKEYEND
	{
		MoveSelection(len(mounterVolumes));
	}
	elseif key == KEYI or key == KEYII
	{
		ActionShowInfoSelected();
	}
}

#@ <MounterMainLoop()>
#@ Mounter event loop.

func MounterMainLoop()
{
	while true
	{
		mounterInDialog = false;

		MounterUpdateScreenSize();

		# Do not render when it is expected that rendering causes broken elements
		# on the screen.
		if mounterScreenWidth < MINTERMWIDTH or mounterScreenHeight < MINTERMHEIGHT
		{
			ClearScreen();
			CursorTo(1, 1);

			Print("Terminal too small");
			getch();

			ClearScreen();
			MounterRefreshDevices();

			mounterSkipFullRedraw = false;

			continue;
		}

		# Viewport size may have changed while getch() was blocked. Re-clamp so
		# the selection stays visible.
		MounterAdjustDiskScroll();
		MounterAdjustScroll();

		if mounterSkipFullRedraw { mounterSkipFullRedraw = false; }
		else { MounterDrawScreen(); }

		if not iserr(mounterWinsizeHandle)
		{
			send(mounterWinsizeHandle, MounterCurrentState());
		}

		var key = getch();

		MounterUpdateScreenSize();

		# Re-clamp before input handlers run so they compute against the
		# same scrollOffset the actor used to redraw.
		MounterAdjustDiskScroll();
		MounterAdjustScroll();

		# Handled here since these binds should work in both sidebar and volume
		# focus modes
		if key == BFKEYESC
		{
			if MounterConfirmExit() { return; }
		}
		elseif key == BFKEYTAB
		{
			if mounterFocusPanel == FOCUSSIDEBAR
			{
				mounterFocusPanel = FOCUSVOLUMES;
			}
			else
			{
				mounterFocusPanel = FOCUSSIDEBAR;
			}
		}
		elseif key == KEYDOT
		{
			mounterShowKeybinds = not mounterShowKeybinds;

			ClearScreen();
		}
		elseif key == KEYHASH
		{
			MounterShowAbout();
		}
		elseif key == KEYR or key == KEYRR
		{
			MounterRefreshDevices();
			ClearScreen();
		}
		elseif mounterFocusPanel == FOCUSSIDEBAR
		{
			MounterHandleSidebarInput(key);
		}
		else
		{
			MounterHandleVolumeInput(key);
		}

		# A winch arriving after the handler ran but before the next iteration
		# would have the actor draw its pre keypress state, so send it now.

		# NOTE: This is more theoretical and less a practical issue, if it causes
		# perf issues (shouldn't), get rid of it
		if not iserr(mounterWinsizeHandle)
		{
			send(mounterWinsizeHandle, MounterCurrentState());
		}
	}
}

#@ <MounterInit()>
#@ Loads the initial device list and spawns the window-resize detector actor.

func MounterInit()
{
	MounterRefreshDevices();

	mounterWinsizeHandle = actor(MounterWinChActor);
}

#@ <MounterCleanup()>
#@ Cleanup before exit.

func MounterCleanup()
{
	ShowCursor();
	ClearScreen();
}

#@ <Main()>
#@ Entry point. Resolves required binaries, loads devices, and runs the main loop.

func Main()
{
	MounterUpdateScreenSize();

	SetTitle(PROGRAMNAME);

	ClearScreen();
	HideCursor();

	if not IsFile(LSBLKPATH) or not IsFile(UDISKSCTLPATH)
	{
		MounterShowError("dfn-mounter requires lsblk and udisksctl");
		MounterCleanup();

		return;
	}

	MounterInit();
	MounterMainLoop();

	MounterCleanup();
}

Main();
