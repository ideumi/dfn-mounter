#!/usr/bin/chippy
#
# dfn-mounter - actions.chh
#

#@ <HandleActionResult(result)>
#@ Evaluates the return value of operation ''result''. Displays a dialog with the
#@ error message in ''result'' if ''not isok(result)'', or a generic error message
#@ if ''iserr(result)''. The devices list will be reloaded no matter what ''result''
#@ is.

func HandleActionResult(result)
{
	if iserr(result) { MounterShowError("Could not start the operation."); }
	elseif not isok(result) { MounterShowError(result); }

	MounterRefreshDevices();
}

#@ <ActionMountSelected()>
#@ Mounts the selected volume if it is an unmounted non LUKS volume.

func ActionMountSelected()
{
	var volume = SelectedVolume();

	if iserr(volume) { return; }
	if IsMounted(volume) { return; }
	if not IsMountable(volume) { return; }

	HandleActionResult(UdisksAction(volume, "mount"));
}

#@ <ActionUnmountSelected()>
#@ Unmounts the selected volume if it is currently mounted.

func ActionUnmountSelected()
{
	var volume = SelectedVolume();

	if iserr(volume) { return; }
	if not IsMounted(volume) { return; }

	HandleActionResult(UdisksAction(volume, "unmount"));
}

#@ <ActionUnlockSelected()>
#@ Unlocks the selected LUKS volume if it is locked.

func ActionUnlockSelected()
{
	var volume = SelectedVolume();

	if iserr(volume) { return; }
	if not IsLuks(volume) { return; }
	if IsLuksUnlocked(volume, mounterDevices) { return; }

	EnterMounterDialog();

	ShowCursor();
	ClearScreen();
	CursorTo(1, 1);

	SetAttribute(COLORBOLD);
	Println("Unlocking " + DeviceDisplayName(volume));
	SetAttribute(COLORRESET);

	var success = isok(UnlockLuks(volume));

	if not success
	{
		Println("");
		Print("Unlock failed. Press any key to continue.");

		getch();
	}

	HideCursor();
	ClearScreen();
	ExitMounterDialog();

	MounterRefreshDevices();
}

#@ <ActionLockSelected()>
#@ Locks the selected unlocked LUKS volume.

func ActionLockSelected()
{
	var volume = SelectedVolume();

	if iserr(volume) { return; }
	if not IsLuks(volume) { return; }
	if not IsLuksUnlocked(volume, mounterDevices) { return; }

	if IsLuksCryptChildMounted(volume, mounterDevices)
	{
		MounterShowError("Cannot lock: the unlocked contents are still mounted. Unmount them first.");

		return;
	}

	HandleActionResult(UdisksAction(volume, "lock"));
}

#@ <ActionEjectSelectedDisk()>
#@ Confirms and performs eject / poweroff of the disk selected in the sidebar.

func ActionEjectSelectedDisk()
{
	var disk = SelectedDisk();

	if iserr(disk) { return; }

	var diskLabel = DiskShortLabel(disk);

	if not IsEjectable(disk)
	{
		MounterShowError("Refusing to power off " + diskLabel + ": is not a removable device.");

		return;
	}

	if DiskHasActiveMember(disk["name"], mounterDevices)
	{
		MounterShowError("Cannot eject " + diskLabel
			+ ": this drive still has mounted or unlocked partitions. Unmount and lock all of them first.");

		return;
	}

	var confirmed = MounterShowConfirm("Power off " + diskLabel + "?");

	if not iserr(confirmed) and confirmed
	{
		HandleActionResult(EjectDisk(disk));
		ClearScreen();
	}
}

#@ <ActionOpenInDfn()>
#@ Replaces the dfn-mounter process with depthfinder launched at the selected
#@ volume's mount point. Shows an error when depthfinder is not installed.

func ActionOpenInDfn()
{
	var volume = SelectedVolume();

	if iserr(volume) { return; }
	if not IsMounted(volume) { return; }

	if not IsFile(DFNPATH)
	{
		MounterShowError("depthfinder is not installed at " + DFNPATH + ".");

		return;
	}

	MounterCleanup();

	exec([DFNPATH, volume["mountpoint"]]);

	HideCursor();
	ClearScreen();

	MounterShowError("Could not start depthfinder at " + DFNPATH + ", exec failed.");
}

#@ <ActionShowInfoSelected()>
#@ Opens the volume info dialog for the selected volume.

func ActionShowInfoSelected()
{
	var volume = SelectedVolume();

	if iserr(volume) { return; }

	MounterShowVolumeInfo(volume);
}

#@ <ActionShowDiskInfoSelected()>
#@ Opens the disk info dialog for the disk selected in the sidebar.

func ActionShowDiskInfoSelected()
{
	var disk = SelectedDisk();

	if iserr(disk) { return; }

	MounterShowDiskInfo(disk);
}
