#!/usr/bin/chippy
#
# dfn-mounter - util.chh
#

#@ <ShellEscape(text)>
#@ Escapes a string for safe use in shell commands.

func ShellEscape(text)
{
	var escaped = replace(text, "'", "'\\''");

	return "'" + escaped + "'";
}

#@ <DefaultIfEmpty(value, fallback)>
#@ Returns ''value'', or ''fallback'' when ''value == ""''.

func DefaultIfEmpty(value, fallback)
{
	if value == "" { return fallback; }

	return value;
}
