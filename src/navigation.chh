#!/usr/bin/chippy
#
# dfn-mounter - navigation.chh
#

#@ <SelectedDevice()>
#@ Returns the currently selected device entry, or ''err'' if the current selection
#@ is not valid. A valid selection is an in-range index pointing at a device and
#@ not a section header.

func SelectedDevice()
{
	if mounterSelectedIndex < 1 or mounterSelectedIndex > len(mounterDevices)
	{
		return err;
	}

	var dev = mounterDevices[mounterSelectedIndex];

	if not IsDeviceEntry(dev) { return err; }

	return dev;
}

#@ <SnapToDevice(start, direction)>
#@ Returns the nearest index that points at a device and not a section header.

func SnapToDevice(start, direction)
{
	if len(mounterDevices) == 0 { return 1; }

	var idx = start;

	while idx >= 1 and idx <= len(mounterDevices)
	{
		if IsDeviceEntry(mounterDevices[idx]) { return idx; }

		idx = idx + direction;
	}

	var opposite = -direction;

	idx = start;

	while idx >= 1 and idx <= len(mounterDevices)
	{
		if IsDeviceEntry(mounterDevices[idx]) { return idx; }

		idx = idx + opposite;
	}

	return start;
}

#@ <MoveSelection(delta)>
#@ Moves the selection by ''delta''.

func MoveSelection(delta)
{
	if len(mounterDevices) == 0 { return; }

	var newIdx = mounterSelectedIndex + delta;

	if newIdx < 1 { newIdx = 1; }
	if newIdx > len(mounterDevices) { newIdx = len(mounterDevices); }

	var direction = 1;

	if delta < 0 { direction = -1; }

	mounterSelectedIndex = SnapToDevice(newIdx, direction);

	MounterAdjustScroll();
}

#@ <MoveSelectionRedraw(delta)>
#@ Moves the selection by ''delta'' and repaints only the two changed rows when the
#@ list did not scroll, in which case the main loop is told to skip its full redraw.

func MoveSelectionRedraw(delta)
{
	var oldIndex = mounterSelectedIndex;
	var oldOffset = mounterScrollOffset;

	MoveSelection(delta);

	# Repaint only the two changed rows when the list did not scroll.
	if mounterScrollOffset == oldOffset
	{
		MounterRedrawDeviceRow(oldIndex);
		MounterRedrawDeviceRow(mounterSelectedIndex);

		mounterSkipFullRedraw = true;
	}
}

#@ <MounterRefreshDevices()>
#@ Reloads the device list.

func MounterRefreshDevices()
{
	# Remember the selected device by name so the cursor follows it even when
	# the list changes.
	var prevName = "";
	var prevSel = SelectedDevice();

	if not iserr(prevSel) { prevName = prevSel["name"]; }

	mounterDevices = SectionizedDevices(LoadDevices());

	var restored = false;

	if prevName != ""
	{
		for i = 1 to len(mounterDevices)
		{
			var entry = mounterDevices[i];

			if IsDeviceEntry(entry) and entry["name"] == prevName
			{
				mounterSelectedIndex = i;
				restored = true;

				break;
			}
		}
	}

	# Previously selected device is gone
	if not restored
	{
		if mounterSelectedIndex > len(mounterDevices)
		{
			mounterSelectedIndex = len(mounterDevices);
		}

		if mounterSelectedIndex < 1 { mounterSelectedIndex = 1; }

		mounterSelectedIndex = SnapToDevice(mounterSelectedIndex, 1);
	}

	MounterAdjustScroll();
}

#@ <GetVisibleDeviceCount()>
#@ Returns how many device rows can be displayed at once.

func GetVisibleDeviceCount()
{
	var region = GetMounterListRegion();

	return int(region[5] / FILEROWHEIGHT);
}

#@ <MounterAdjustScroll()>
#@ Adjusts scroll offset to keep selection visible.

func MounterAdjustScroll()
{
	var visibleDevices = GetVisibleDeviceCount();

	if mounterSelectedIndex < mounterScrollOffset
	{
		mounterScrollOffset = mounterSelectedIndex;
	}

	if mounterSelectedIndex >= mounterScrollOffset + visibleDevices
	{
		mounterScrollOffset = mounterSelectedIndex - visibleDevices + 1;
	}

	# Avoid empty rows below the last device when devices fit the viewport.
	var maxOffset = len(mounterDevices) - visibleDevices + 1;

	if maxOffset < 1 { maxOffset = 1; }
	if mounterScrollOffset > maxOffset { mounterScrollOffset = maxOffset; }
	if mounterScrollOffset < 1 { mounterScrollOffset = 1; }

	# If a section header sits just above the viewport, scroll up so it stays
	# visible. Otherwise the selected device shows without its section label.
	# Stop once scrolling further up would push the selection off the bottom.
	while mounterScrollOffset > 1 and not IsDeviceEntry(mounterDevices[mounterScrollOffset - 1])
	{
		if mounterSelectedIndex > mounterScrollOffset + visibleDevices - 2
		{
			break;
		}

		mounterScrollOffset = mounterScrollOffset - 1;
	}
}
