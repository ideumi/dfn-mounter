#!/usr/bin/chippy
#
# dfn-mounter - navigation.chh
#

#@ <SnapToDisk(start, direction)>
#@ Returns the nearest sidebar index that points at a disk entry and not a
#@ section header.

func SnapToDisk(start, direction)
{
	if len(mounterDisks) == 0 { return 1; }

	var idx = start;

	# Walk in the requested direction to the nearest disk entry
	while idx >= 1 and idx <= len(mounterDisks)
	{
		if IsDeviceEntry(mounterDisks[idx]) { return idx; }

		idx = idx + direction;
	}

	# Then try the opposite direction from the start
	var opposite = -direction;

	idx = start;

	while idx >= 1 and idx <= len(mounterDisks)
	{
		if IsDeviceEntry(mounterDisks[idx]) { return idx; }

		idx = idx + opposite;
	}

	# No disk entry can be found, keep the original index
	return start;
}

#@ <MounterAdjustDiskScroll()>
#@ Keeps the selected disk visible in the sidebar.

func MounterAdjustDiskScroll()
{
	if mounterDiskScrollOffset < 1 { mounterDiskScrollOffset = 1; }

	# mounterDiskScrollOffset is the index of the first visible entry

	# Entries have different heights (section headers are taller than disk rows),
	# so which entries are visible depends on where the list starts.
	# MounterLastDrawableDisk(offset) returns the index of the last entry that
	# fits when the list starts at offset

	# Selection above the sidebar: start the sidebar at the selection
	if mounterSelectedDisk < mounterDiskScrollOffset
	{
		mounterDiskScrollOffset = mounterSelectedDisk;
	}

	# Selection below the visible area: because entry heights vary, there is no
	# direct offset to jump to, so step the sidebar down one entry at a time
	# until the selection fits
	while mounterSelectedDisk > MounterLastDrawableDisk(mounterDiskScrollOffset)
		and mounterDiskScrollOffset < len(mounterDisks)
	{
		mounterDiskScrollOffset = mounterDiskScrollOffset + 1;
	}

	# If the list now fits in the sidebar completely, scroll back up: step the
	# offset up until going higher would hide the last entry
	while mounterDiskScrollOffset > 1
		and MounterLastDrawableDisk(mounterDiskScrollOffset - 1) >= len(mounterDisks)
	{
		mounterDiskScrollOffset = mounterDiskScrollOffset - 1;
	}
}

#@ <MoveDiskSelection(delta)>
#@ Moves the sidebar selection by ''delta''.

func MoveDiskSelection(delta)
{
	if len(mounterDisks) == 0 { return; }

	var newIdx = mounterSelectedDisk + delta;

	if newIdx < 1 { newIdx = 1; }
	if newIdx > len(mounterDisks) { newIdx = len(mounterDisks); }

	var direction = 1;

	if delta < 0 { direction = -1; }

	mounterSelectedDisk = SnapToDisk(newIdx, direction);

	MounterAdjustDiskScroll();
}

#@ <NavigateToDisk(disk)>
#@ Makes ''disk'' the active one and loads its volumes into the volume list.

func NavigateToDisk(disk)
{
	mounterActiveDisk = disk["name"];
	mounterVolumes = VolumesForDisk(mounterDevices, mounterActiveDisk);

	# Start on the first volume of the new disk, scrolled to the top
	mounterSelectedIndex = 1;
	mounterScrollOffset = 1;

	MounterAdjustScroll();
}

#@ <GetVisibleVolumeCount()>
#@ Returns how many volume rows can be displayed at once.

func GetVisibleVolumeCount()
{
	var region = GetMounterListRegion(mounterScreenWidth, mounterScreenHeight);

	# Each entry occupies VOLUMEROWHEIGHT rows on screen
	return int(region[5] / VOLUMEROWHEIGHT);
}

#@ <MounterAdjustScroll()>
#@ Keeps the selection visible in the volume list.

func MounterAdjustScroll()
{
	var visibleVolumes = GetVisibleVolumeCount();

	# ''mounterScrollOffset'' is the index of the first visible row.

	# The volume list shows rows from mounterScrollOffset to
	# mounterScrollOffset + visibleVolumes - 1, each entry takes VOLUMEROWHEIGHT
	# rows on screen

	# Selection above the volume list: start the volume list at the selection
	if mounterSelectedIndex < mounterScrollOffset
	{
		mounterScrollOffset = mounterSelectedIndex;
	}

	# Selection below the volume list: slide the volume list down until the
	# selection is its last visible row
	if mounterSelectedIndex >= mounterScrollOffset + visibleVolumes
	{
		mounterScrollOffset = mounterSelectedIndex - visibleVolumes + 1;
	}

	# After this, the panel is in one of two states. If the list is longer than
	# the panel, every row holds a real entry, the selection is one of them, and
	# the furthest top row is the one where the last visible entry is the last
	# entry in the list. If the list is shorter, the entries sit on the top rows,
	# the rest is blank, and the top row stays at 1
	var maxOffset = len(mounterVolumes) - visibleVolumes + 1;

	if maxOffset < 1 { maxOffset = 1; }
	if mounterScrollOffset > maxOffset { mounterScrollOffset = maxOffset; }
	if mounterScrollOffset < 1 { mounterScrollOffset = 1; }
}

#@ <MoveSelection(delta)>
#@ Moves the selection by ''delta''.

func MoveSelection(delta)
{
	if len(mounterVolumes) == 0 { return; }

	var newIdx = mounterSelectedIndex + delta;

	if newIdx < 1 { newIdx = 1; }
	if newIdx > len(mounterVolumes) { newIdx = len(mounterVolumes); }

	mounterSelectedIndex = newIdx;

	MounterAdjustScroll();
}

#@ <MoveSelectionRedraw(delta)>
#@ Moves the selection by ''delta'' and repaints only the two changed rows when
#@ the list did not scroll, in which case the main loop is told to skip its full
#@ redraw.

func MoveSelectionRedraw(delta)
{
	var oldIndex = mounterSelectedIndex;
	var oldOffset = mounterScrollOffset;

	MoveSelection(delta);

	# Repaint only the title bar and the two changed rows when the list did not
	# scroll.
	if mounterScrollOffset == oldOffset
	{
		var panel = GetMounterRegion(mounterScreenWidth, mounterScreenHeight);

		MounterDrawHeaderBar(panel[1], panel[2], panel[3]);
		MounterRedrawVolumeRow(oldIndex);
		MounterRedrawVolumeRow(mounterSelectedIndex);

		mounterSkipFullRedraw = true;
	}
}

#@ <MounterRefreshDevices()>
#@ Reloads the device list, rebuilds the sidebar and the volume list, and keeps
#@ both selections on the same entries where they still exist.

func MounterRefreshDevices()
{
	# Remember both selections by name so the cursors follow them even when the
	# lists change.
	var prevDisk = SelectedDisk();
	var prevVolume = SelectedVolume();

	var prevDiskName = "";
	var prevVolumeName = "";

	if not iserr(prevDisk) { prevDiskName = prevDisk["name"]; }
	if not iserr(prevVolume) { prevVolumeName = prevVolume["name"]; }

	mounterDevices = LoadDevices();
	mounterDisks = BuildDiskList(mounterDevices);

	var diskIndex = IndexOfName(mounterDisks, prevDiskName);

	if iserr(diskIndex) { mounterSelectedDisk = SnapToDisk(1, 1); }
	else { mounterSelectedDisk = diskIndex; }

	if iserr(ActiveDisk())
	{
		var disk = SelectedDisk();

		if iserr(disk) { mounterActiveDisk = ""; }
		else { mounterActiveDisk = disk["name"]; }
	}

	mounterVolumes = VolumesForDisk(mounterDevices, mounterActiveDisk);

	MounterAdjustDiskScroll();

	var volumeIndex = IndexOfName(mounterVolumes, prevVolumeName);

	if iserr(volumeIndex) { mounterSelectedIndex = 1; }
	else { mounterSelectedIndex = volumeIndex; }

	MounterAdjustScroll();
}
