#!/usr/bin/chippy
#
# dfn-mounter - constants.chh
#

# --- Program ---

#@ <VERSION>
#@ Program version string

var VERSION = "1.0.4";

#@ <PROGRAMNAME>
#@ Program display name

var PROGRAMNAME = "dfn-mounter";

# --- UI ---

#@ <DIALOGWIDTH>
#@ Standard width for dialog boxes

var DIALOGWIDTH = 55;

#@ <KEYBINDSBARHEIGHT>
#@ Height of the keybinds bar at the bottom

var KEYBINDSBARHEIGHT = 3;

#@ <VOLUMEROWHEIGHT>
#@ Height of each volume entry

var VOLUMEROWHEIGHT = 2;

#@ <SIDEBARWIDTH>
#@ Width of the disk sidebar

var SIDEBARWIDTH = 34;

#@ <SIDEBARROWHEIGHT>
#@ Height of each sidebar disk entry

var SIDEBARROWHEIGHT = 2;

#@ <SIDEBARSECTIONHEIGHT>
#@ Height of a sidebar section header

var SIDEBARSECTIONHEIGHT = 2;

#@ <SIDEBARSECTIONGAP>
#@ Extra blank row above a section header

var SIDEBARSECTIONGAP = 1;

#@ <TITLEBARHEIGHT>
#@ Rows the volume panel title bar occupies

var TITLEBARHEIGHT = 2;

#@ <LISTHEADERHEIGHT>
#@ Rows the volume list column header occupies

var LISTHEADERHEIGHT = 2;

#@ <MINTERMWIDTH>
#@ Minimum required terminal width

var MINTERMWIDTH = 95;

#@ <MINTERMHEIGHT>
#@ Minimum required terminal height

var MINTERMHEIGHT = 17;

# --- Focus panel ---

#@ <FOCUSSIDEBAR>
#@ Focus is on the disk sidebar

var FOCUSSIDEBAR = 1;

#@ <FOCUSVOLUMES>
#@ Focus is on the volume list

var FOCUSVOLUMES = 2;

# --- Device resolution ---

#@ <MAXPARENTDEPTH>
#@ Max parent hops to resolve root disk

var MAXPARENTDEPTH = 10;

# --- External tools ---

#@ <LSBLKPATH>
#@ Path to lsblk

var LSBLKPATH = "/usr/bin/lsblk";

#@ <UDISKSCTLPATH>
#@ Path to udisksctl

var UDISKSCTLPATH = "/usr/bin/udisksctl";

#@ <DFNPATH>
#@ Path to depthfinder

var DFNPATH = "/usr/bin/dfn";

#@ <LSBLKCOLUMNS>
#@ Columns for lsblk -Pno

var LSBLKCOLUMNS = "NAME,KNAME,SIZE,TYPE,FSTYPE,LABEL,UUID,MOUNTPOINT,MODEL,SERIAL,PKNAME,RM,TRAN";

#@ <TTYREDIRECT>
#@ TTY redirect suffix

var TTYREDIRECT = " < /dev/tty > /dev/tty 2>&1";

#@ <SWAPMOUNTPOINT>
#@ Mount points for swap partitions get reported as this by lsblk
#@ MOUNTPOINT="[SWAP]"

var SWAPMOUNTPOINT = "[SWAP]";

# --- Colors ---

#@ <DFNCOLORDIM>
#@ 256-color greyscale color

var DFNCOLORDIM = 240;

#@ <DFNCOLORACCENT>
#@ Primary accent color for some handpicked elements, as ''r'', ''g'' and ''b''
#@ color map

var DFNCOLORACCENT = m["r": 0, "g": 0, "b": 255];

# --- Keys ---

#@ <KEYDOT>
#@ '.' key

var KEYDOT = b[46];

#@ <KEYE>
#@ 'e' key

var KEYE = b[101];

#@ <KEYEE>
#@ 'E' key

var KEYEE = b[69];

#@ <KEYI>
#@ 'i' key

var KEYI = b[105];

#@ <KEYII>
#@ 'I' key

var KEYII = b[73];

#@ <KEYR>
#@ 'r' key

var KEYR = b[114];

#@ <KEYRR>
#@ 'R' key

var KEYRR = b[82];

#@ <KEYHASH>
#@ '#' key
var KEYHASH = b[35];

#@ <EGG>
#@ The distinct lack of ''EGG'' disturbs you
