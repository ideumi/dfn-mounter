#!/usr/bin/chippy
#
# dfn-mounter - devices.chh
#

#@ <ParsePairValue(line, key)>
#@ Extracts the value of ''key'' out of a KEY="value" ''line'' from lsblk -P.

func ParsePairValue(line, key)
{
	var search = key + "=\"";
	var idx = indexof(line, search);

	if iserr(idx) { return ""; }

	var start = idx + len(search);
	var lineLen = len(line);

	# Find closing quote and skip \" escapes
	var pos = start;
	var endPos = err;

	while pos <= lineLen
	{
		var ch = slice(line, pos, pos);

		if ch == "\\" and pos < lineLen
		{
			# Skip escaped char
			pos = pos + 2;

			continue;
		}

		if ch == "\""
		{
			endPos = pos;

			break;
		}

		pos = pos + 1;
	}

	if iserr(endPos) { return ""; }
	if endPos == start { return ""; }

	var raw = slice(line, start, endPos - 1);

	# Unescape \\ and \"
	raw = replace(raw, "\\\"", "\"");
	raw = replace(raw, "\\\\", "\\");

	return raw;
}

#@ <ResolveDisk(name, parentMap)>
#@ Walks the ''parentMap'' chain to find the root disk device name.

func ResolveDisk(name, parentMap)
{
	var current = name;

	for hop = 1 to MAXPARENTDEPTH
	{
		if not has(parentMap, current) { return current; }

		var parent = parentMap[current];

		if parent == "" { return current; }

		current = parent;
	}

	return current;
}

#@ <LoadDevices()>
#@ Loads block devices from lsblk. Returns a list of device maps, or an empty list
#@ on failure.
#@
#@ Map fields:
#@ - ''"name"'' (String): device name, e.g. ''sda1'' or ''nvme0n1p3_crypt''
#@ - ''"size"'' (String): human-readable size, e.g. ''8G''
#@ - ''"type"'' (String): device type, one of ''disk'', ''part'', ''crypt'', ''lvm''
#@ - ''"fstype"'' (String): filesystem type, e.g. ''ext4'' or ''crypto_LUKS''
#@ - ''"label"'' (String): filesystem label
#@ - ''"uuid"'' (String): filesystem UUID
#@ - ''"mountpoint"'' (String): current mountpoint, or ''[SWAP]''
#@ - ''"model"'' (String): parent disk model
#@ - ''"serial"'' (String): parent disk serial number
#@ - ''"diskSize"'' (String): human-readable size of the parent disk, e.g. ''1T''
#@ - ''"pkname"'' (String): kernel name of the immediate parent device
#@ - ''"parent"'' (String): resolved name of the immediate parent device
#@ - ''"disk"'' (String): resolved root disk name from walking the parent chain
#@ - ''"removable"'' (Bool): whether the parent disk is removable
#@ - ''"transport"'' (String): parent disk transport, e.g. ''usb'' or ''nvme''

func LoadDevices()
{
	var output = RunCapture(LSBLKPATH + " -Pno " + LSBLKCOLUMNS + " 2>/dev/null");

	if iserr(output) { return []; }

	var lines = split(output, "\n");

	# Map kernel names (dm-0) to readable names (nvme0n1p3_crypt) so PKNAME parent
	# references can be resolved back to those readable names
	var knameToName = m[];

	for lineIndex = 1 to len(lines)
	{
		var line = Trim(lines[lineIndex]);

		if line == "" { continue; }

		var name = ParsePairValue(line, "NAME");
		var kname = ParsePairValue(line, "KNAME");

		if kname != "" { knameToName[kname] = name; }
	}

	# Disk attributes
	var diskAttrs = m[];

	# Child to parent map
	var parentMap = m[];

	for lineIndex = 1 to len(lines)
	{
		var line = Trim(lines[lineIndex]);

		if line == "" { continue; }

		var name = ParsePairValue(line, "NAME");
		var pkname = ParsePairValue(line, "PKNAME");
		var devType = ParsePairValue(line, "TYPE");

		if pkname != ""
		{
			var resolvedParent = pkname;

			if has(knameToName, pkname)
			{
				resolvedParent = knameToName[pkname];
			}

			parentMap[name] = resolvedParent;
		}

		if devType == "disk"
		{
			diskAttrs[name] = m[
				"model": ParsePairValue(line, "MODEL"),
				"serial": ParsePairValue(line, "SERIAL"),
				"diskSize": ParsePairValue(line, "SIZE"),
				"removable": ParsePairValue(line, "RM") == "1",
				"transport": ParsePairValue(line, "TRAN")
			];
		}
	}

	var devices = [];

	for lineIndex = 1 to len(lines)
	{
		var line = Trim(lines[lineIndex]);

		if line == "" { continue; }

		var devType = ParsePairValue(line, "TYPE");

		if devType != "disk" and devType != "part" and devType != "crypt" and devType != "lvm"
		{
			continue;
		}

		var name = ParsePairValue(line, "NAME");
		var size = ParsePairValue(line, "SIZE");
		var fstype = ParsePairValue(line, "FSTYPE");
		var label = ParsePairValue(line, "LABEL");
		var uuid = ParsePairValue(line, "UUID");
		var mountpoint = ParsePairValue(line, "MOUNTPOINT");
		var pkname = ParsePairValue(line, "PKNAME");

		var parent = "";

		if has(parentMap, name) { parent = parentMap[name]; }

		# Resolve parent-disk attributes
		var disk = ResolveDisk(name, parentMap);
		var model = "";
		var serial = "";
		var diskSize = "";
		var removable = false;
		var transport = "";

		if has(diskAttrs, disk)
		{
			var attrs = diskAttrs[disk];

			model = attrs["model"];
			serial = attrs["serial"];
			diskSize = attrs["diskSize"];
			removable = attrs["removable"];
			transport = attrs["transport"];
		}

		var dev = m[
			"name": name,
			"size": size,
			"type": devType,
			"fstype": fstype,
			"label": label,
			"uuid": uuid,
			"mountpoint": mountpoint,
			"model": model,
			"serial": serial,
			"diskSize": diskSize,
			"pkname": pkname,
			"parent": parent,
			"disk": disk,
			"removable": removable,
			"transport": transport
		];

		append(devices, dev);
	}

	return devices;
}

#@ <IsDeviceEntry(entry)>
#@ Returns ''true'' if the ''entry'' is a real device and not a section header.

func IsDeviceEntry(entry)
{
	if not has(entry, "type") { return false; }

	return entry["type"] != "section";
}

#@ <BuildDiskList(devices)>
#@ Builds a list of only the parent disks in ''devices'' and groups them. Returns
#@ the list of parent disks with section header entries inserted (for the sidebar).
#@
#@ Disk map fields:
#@ - ''"type"'' (String): always ''disk''
#@ - ''"name"'' (String): disk name, e.g. ''nvme0n1''
#@ - ''"disk"'' (String): same as ''"name"'', so disk helpers accept the entry
#@ - ''"model"'' (String): disk model
#@ - ''"serial"'' (String): disk serial number
#@ - ''"size"'' (String): human-readable disk size, e.g. ''1T''
#@ - ''"removable"'' (Bool): whether the disk is removable
#@ - ''"transport"'' (String): disk transport, e.g. ''usb'' or ''nvme''
#@
#@ - volume-only fields (''fstype'', ''label'', ''uuid'', ''mountpoint'', ''pkname'' and ''parent'') are all ''err''
#@
#@ Section header entries have only two fields: ''"type"'' (always ''section'')
#@ and ''"label"'' (the section title, one of ''Removable'', ''Internal'' or
#@ ''System'').

func BuildDiskList(devices)
{
	var systemDisk = "";
	var seen = m[];
	var disks = [];

	for deviceIndex = 1 to len(devices)
	{
		var device = devices[deviceIndex];
		var name = device["disk"];

		if device["mountpoint"] == "/" { systemDisk = name; }

		if name == "" { continue; }
		if has(seen, name) { continue; }

		seen[name] = true;

		# These err fields are here for parity so we don't have two different
		# device map forms.
		# TODO: Maybe centralize this into the chippy equivalent of a constructor
		# at some point.

		append(disks, m[
				"type": "disk",
				"name": name,
				"disk": name,
				"model": device["model"],
				"serial": device["serial"],
				"size": device["diskSize"],
				"removable": device["removable"],
				"transport": device["transport"],
				"fstype": err,
				"label": err,
				"uuid": err,
				"mountpoint": err,
				"pkname": err,
				"parent": err
			]);
	}

	var removable = [];
	var internal = [];
	var system = [];

	for diskIndex = 1 to len(disks)
	{
		var disk = disks[diskIndex];

		# Check system before removable so a live-USB boot drive lands in the
		# System section instead of Removable.

		if systemDisk != "" and disk["name"] == systemDisk
		{
			append(system, disk);
		}
		elseif IsEjectable(disk)
		{
			append(removable, disk);
		}
		else
		{
			append(internal, disk);
		}
	}

	# Only show section headers when they're not empty
	var result = [];

	if len(removable) > 0
	{
		var removableHeader = m[
			"type": "section",
			"label": "Removable"
		];

		result = result + [removableHeader] + removable;
	}

	if len(internal) > 0
	{
		var internalHeader = m[
			"type": "section",
			"label": "Internal"
		];

		result = result + [internalHeader] + internal;
	}

	if len(system) > 0
	{
		var systemHeader = m[
			"type": "section",
			"label": "System"
		];

		result = result + [systemHeader] + system;
	}

	return result;
}

#@ <VolumesForDisk(devices, diskName)>
#@ Returns every device in ''devices'' whose parent disk is ''diskName''.
#@
#@ Map fields: the device map fields from ''LoadDevices()''.

func VolumesForDisk(devices, diskName)
{
	var volumes = [];

	if diskName == "" { return volumes; }

	for deviceIndex = 1 to len(devices)
	{
		var device = devices[deviceIndex];

		if device["disk"] != diskName { continue; }
		if device["type"] == "disk" and device["fstype"] == "" { continue; }

		append(volumes, device);
	}

	return volumes;
}

#@ <IsLuks(dev)>
#@ Returns ''true'' if the ''dev''ice has a LUKS filesystem type.

func IsLuks(dev)
{
	return dev["fstype"] == "crypto_LUKS";
}

#@ <IsLuksUnlocked(dev, devices)>
#@ Returns ''true'' if a LUKS ''dev''ice has an unlocked crypt child in the device
#@ list.

func IsLuksUnlocked(dev, devices)
{
	if not IsLuks(dev) { return false; }

	var name = dev["name"];

	for deviceIndex = 1 to len(devices)
	{
		var other = devices[deviceIndex];

		if other["type"] == "crypt"
		{
			if other["parent"] == name { return true; }
		}
	}

	return false;
}

#@ <IsSwap(dev)>
#@ Returns ''true'' if the ''dev''ice is an active swap area.

func IsSwap(dev)
{
	return dev["mountpoint"] == SWAPMOUNTPOINT;
}

#@ <IsMounted(dev)>
#@ Returns ''true'' if the ''dev''ice is mounted at a real path. Active swap is
#@ deliberately excluded.

func IsMounted(dev)
{
	if IsSwap(dev) { return false; }

	return dev["mountpoint"] != "";
}

#@ <IsMountable(dev)>
#@ Returns ''true'' if the ''dev''ice is a plausible mount target for udisksctl.

func IsMountable(dev)
{
	# LUKS containers must be unlocked first
	if IsLuks(dev) { return false; }

	# Swap is mounted by the kernel
	if IsSwap(dev) { return false; }

	var fstype = dev["fstype"];

	# Empty or LVM2_member fstypes have no mountable filesystem.
	if fstype == "" { return false; }
	if fstype == "LVM2_member" { return false; }

	return true;
}

#@ <IsLuksCryptChildMounted(dev, devices)>
#@ Returns ''true'' if the unlocked LUKS ''dev''ice has a crypt child that is
#@ currently mounted.

func IsLuksCryptChildMounted(dev, devices)
{
	var name = dev["name"];

	for deviceIndex = 1 to len(devices)
	{
		var other = devices[deviceIndex];

		if other["type"] == "crypt" and other["parent"] == name and IsMounted(other)
		{
			return true;
		}
	}

	return false;
}

#@ <DiskHasActiveMember(diskName, devices)>
#@ Returns ''true'' if any device on the given parent disk is mounted, in active
#@ use as swap, or has an unlocked LUKS child.

func DiskHasActiveMember(diskName, devices)
{
	for deviceIndex = 1 to len(devices)
	{
		var device = devices[deviceIndex];

		if device["disk"] != diskName { continue; }

		if IsMounted(device) { return true; }
		if IsSwap(device) { return true; }
		if IsLuks(device) and IsLuksUnlocked(device, devices) { return true; }
	}

	return false;
}

#@ <DevicePath(dev)>
#@ Returns the /dev/ path for a ''dev''ice.

func DevicePath(dev)
{
	var name = dev["name"];
	var devType = dev["type"];

	# crypt and lvm devices resolve under /dev/mapper/ since they are device
	# mapper nodes
	if devType == "crypt" or devType == "lvm" { return "/dev/mapper/" + name; }

	return "/dev/" + name;
}

#@ <IsEjectable(dev)>
#@ Returns ''true'' if the ''dev''ice's parent disk is safe to power off.

func IsEjectable(dev)
{
	if dev["transport"] == "usb" { return true; }
	if dev["removable"] { return true; }

	return false;
}
