#!/usr/bin/chippy
#
# dfn-mounter - ui.chh
#

#@ <DeviceStatusText(dev, devices)>
#@ Returns the status string used in the STATUS column and the volume info dialog.

func DeviceStatusText(dev, devices)
{
	if IsLuks(dev)
	{
		if IsLuksUnlocked(dev, devices) { return "[LUKS unlocked]"; }

		return "[LUKS locked]";
	}

	if IsSwap(dev) { return "[swap]"; }

	if IsMounted(dev) { return dev["mountpoint"]; }

	if dev["fstype"] == "LVM2_member" { return "[LVM]"; }

	return "[unmounted]";
}

#@ <SerialTail(serial)>
#@ Returns the last 6 characters of the ''serial'' number, prefixed with "...".
#@ Returns the whole serial if it is 6 characters or shorter.

func SerialTail(serial)
{
	if serial == "" { return ""; }

	var serialLen = len(serial);

	if serialLen <= 6 { return serial; }

	return "..." + Right(serial, 6);
}

#@ <DiskShortLabel(dev)>
#@ Returns a label for the parent disk: ''"<model> (...SerialTail(serial))"''
#@ when both are available, otherwise the disk name path.

func DiskShortLabel(dev)
{
	var model = dev["model"];
	var serial = dev["serial"];
	var disk = dev["disk"];

	var label = "";

	if model != "" { label = model; }
	else { label = "/dev/" + disk; }

	var tail = SerialTail(serial);

	if tail != "" { label = label + " (" + tail + ")"; }

	return label;
}

#@ <DeviceTypeDescription(dev)>
#@ Returns a description of a ''dev''ice's role.

func DeviceTypeDescription(dev)
{
	var devType = dev["type"];
	var fstype = dev["fstype"];

	if devType == "part" and fstype == "crypto_LUKS"
	{
		return "LUKS container";
	}
	if devType == "disk" { return "Disk"; }
	if devType == "part" { return "Partition"; }
	if devType == "crypt" and fstype == "LVM2_member"
	{
		return "LUKS volume (LVM PV)";
	}
	if devType == "crypt" { return "LUKS volume"; }
	if devType == "lvm" { return "LVM logical volume"; }

	return devType;
}

#@ <DeviceDisplayName(dev)>
#@ Returns the display name for a ''dev''ice.

func DeviceDisplayName(dev)
{
	var label = dev["label"];
	var name = dev["name"];

	if label != "" { return label + " (" + name + ")"; }

	return name;
}

#@ <SidebarDiskTitle(disk)>
#@ Returns the first line of a sidebar entry: the ''disk'' model, or its name
#@ when no model is known.

func SidebarDiskTitle(disk)
{
	var model = disk["model"];

	if model != "" { return model; }

	return disk["name"];
}

#@ <SidebarDiskDetail(disk)>
#@ Builds the second line of a sidebar entry: the ''disk'' name, plus its size
#@ and serial tail when known, joined with ''|''.

func SidebarDiskDetail(disk)
{
	var detail = disk["name"];
	var size = disk["size"];
	var tail = SerialTail(disk["serial"]);

	if size != "" { detail = detail + " | " + size; }
	if tail != "" { detail = detail + " | " + tail; }

	return detail;
}

#@ <MounterGetColumnWidths(width)>
#@ Returns the volume list column widths ''[nameColWidth, fsColWidth,
#@ statusColWidth, sizeColWidth]'' for a content area of ''width'' columns.

func MounterGetColumnWidths(width)
{
	var sizeColWidth = 7;
	var fsColWidth = 11;
	var statusColWidth = 19;
	var nameColWidth = width - fsColWidth - statusColWidth - sizeColWidth - 3;

	return [nameColWidth, fsColWidth, statusColWidth, sizeColWidth];
}

#@ <GetMounterRegion(screenWidth, screenHeight)>
#@ Returns the region right of the sidebar: ''[x, y, width, height]''.

func GetMounterRegion(screenWidth, screenHeight)
{
	var x = SIDEBARWIDTH + 2;
	var y = 1;
	var width = screenWidth - SIDEBARWIDTH - 2;
	var height = screenHeight - MounterBottomReserve();

	return [x, y, width, height];
}

#@ <GetMounterSidebarRegion(screenHeight)>
#@ Returns the region of the disk sidebar: ''[x, y, width, height]''.

func GetMounterSidebarRegion(screenHeight)
{
	var x = 1;
	var y = 1;
	var width = SIDEBARWIDTH;
	var height = screenHeight - MounterBottomReserve();

	return [x, y, width, height];
}

#@ <MounterSidebarEntryHeight(entry, isFirst)>
#@ Returns how many rows a sidebar entry occupies.

func MounterSidebarEntryHeight(entry, isFirst)
{
	if IsDeviceEntry(entry) { return SIDEBARROWHEIGHT; }

	if isFirst { return SIDEBARSECTIONHEIGHT; }

	return SIDEBARSECTIONHEIGHT + SIDEBARSECTIONGAP;
}

#@ <MounterLastDrawableDisk(offset)>
#@ Returns the index of the last sidebar entry that fits when the list starts at
#@ ''offset'', or ''offset - 1'' if none fit.

func MounterLastDrawableDisk(offset)
{
	var region = GetMounterSidebarRegion(mounterScreenHeight);

	var lastY = region[2] + region[4] - 1;
	var rowY = region[2];
	var last = offset - 1;

	for idx = offset to len(mounterDisks)
	{
		var entryHeight = MounterSidebarEntryHeight(mounterDisks[idx], idx == offset);

		if rowY + entryHeight - 1 > lastY { break; }

		rowY = rowY + entryHeight;
		last = idx;
	}

	# A section header needs at least one disk under it
	if last >= offset and not IsDeviceEntry(mounterDisks[last])
	{
		last = last - 1;
	}

	return last;
}

#@ <GetMounterListRegion(screenWidth, screenHeight)>
#@ Returns the region of the volume list: ''[x, headerY, listY, width, height]''.

func GetMounterListRegion(screenWidth, screenHeight)
{
	var region = GetMounterRegion(screenWidth, screenHeight);

	var headerY = region[2] + TITLEBARHEIGHT;
	var listY = headerY + LISTHEADERHEIGHT;

	return [region[1], headerY, listY, region[3], region[2] + region[4] - listY];
}

#@ <MounterDrawTitleBar(x, y, width)>
#@ Draws the path of the currently selected volume above the volume list.

func MounterDrawTitleBar(x, y, width)
{
	BFClearRegion(x, y, width, TITLEBARHEIGHT);

	var path = "";
	var volume = SelectedVolume();

	if not iserr(volume) { path = DevicePath(volume); }
	elseif mounterActiveDisk != "" { path = "/dev/" + mounterActiveDisk; }

	if path == "" { return; }

	var hasFocus = mounterFocusPanel == FOCUSVOLUMES;

	if hasFocus { SetAttribute(COLORBOLD); }

	BFDrawText(x, y, BFTruncateMiddle(path, width));

	if hasFocus { SetAttribute(COLORRESET); }
}

#@ <MounterDrawHeader(x, y, width)>
#@ Draws the column header row.

func MounterDrawHeader(x, y, width)
{
	BFClearRegion(x, y, width, LISTHEADERHEIGHT);

	var cols = MounterGetColumnWidths(width);
	var nameColWidth = cols[1];
	var fsColWidth = cols[2];
	var statusColWidth = cols[3];
	var sizeColWidth = cols[4];

	var nameHeader = BFPadText("  VOLUME", nameColWidth, BFALIGNLEFT);
	var fsHeader = BFPadText("FSTYPE", fsColWidth, BFALIGNLEFT);
	var statusHeader = BFPadText("STATUS", statusColWidth, BFALIGNRIGHT);
	var sizeHeader = BFPadText("SIZE", sizeColWidth, BFALIGNRIGHT);

	var header = nameHeader + " " + fsHeader + " " + statusHeader + " " + sizeHeader;

	SetAttribute(COLORBOLD);
	BFDrawText(x, y, header);
	SetAttribute(COLORRESET);
}

#@ <MounterDrawVolumeRow(x, baseY, width, nameColWidth, fsColWidth, statusColWidth, sizeColWidth, idx)>
#@ Draws a single volume list row at position ''baseY''.

func MounterDrawVolumeRow(x, baseY, width, nameColWidth, fsColWidth, statusColWidth, sizeColWidth, idx)
{
	var emptyRow = BFPadText("", width, BFALIGNLEFT);

	if idx >= 1 and idx <= len(mounterVolumes)
	{
		var volume = mounterVolumes[idx];
		var displayName = DeviceDisplayName(volume);
		var size = volume["size"];
		var isSelected = idx == mounterSelectedIndex and mounterFocusPanel == FOCUSVOLUMES;

		if isSelected
		{
			SetAttribute(COLORBLACK);
			SetAttribute(COLORBOLD);
			SetAttribute(COLORBGWHITE);
		}
		elseif IsMounted(volume)
		{
			SetAttribute(COLORBOLD);
			SetAttribute(COLORCYAN);
		}
		elseif IsLuks(volume)
		{
			SetAttribute(COLORBOLD);
			SetAttribute(COLORMAGENTA);
		}

		var status = DeviceStatusText(volume, mounterDevices);

		# Build columns
		var nameText = "  " + displayName;
		nameText = BFClipText(nameText, nameColWidth);
		nameText = BFPadText(nameText, nameColWidth, BFALIGNLEFT);

		var fsText = BFClipText(volume["fstype"], fsColWidth);
		fsText = BFPadText(fsText, fsColWidth, BFALIGNLEFT);

		var sizeText = BFClipText(size, sizeColWidth);
		sizeText = BFPadText(sizeText, sizeColWidth, BFALIGNRIGHT);

		var statusText = BFTruncateMiddle(status, statusColWidth);
		statusText = BFPadText(statusText, statusColWidth, BFALIGNRIGHT);

		var rowText = nameText + " " + fsText + " " + statusText + " " + sizeText;

		BFDrawText(x, baseY, rowText);

		# Spacing
		BFDrawText(x, baseY + 1, emptyRow);
	}
	else
	{
		BFDrawText(x, baseY, emptyRow);
		BFDrawText(x, baseY + 1, emptyRow);
	}

	SetAttribute(COLORRESET);
}

#@ <MounterDrawEmptyState(x, y, width, height)>
#@ Draws the placeholder that is shown when the selected disk has no volumes.

func MounterDrawEmptyState(x, y, width, height)
{
	BFClearRegion(x, y, width, height);

	if height < 3 { return; }

	var origin = BFCenterRect([x, y, width, height], width, 3);
	var shrugY = origin[2];

	SetFGColor256(DFNCOLORDIM);
	BFDrawText(x, shrugY, BFPadText("¯\\_(ツ)_/¯", width, BFALIGNCENTER));
	BFDrawText(x, shrugY + 2, BFPadText("There is nothing here", width, BFALIGNCENTER));
	SetAttribute(COLORRESET);
}

#@ <MounterDrawVolumeList(x, y, width, height)>
#@ Draws the volume list, or the empty state when the selected disk has no volumes.

func MounterDrawVolumeList(x, y, width, height)
{
	if len(mounterVolumes) == 0
	{
		MounterDrawEmptyState(x, y, width, height);

		return;
	}

	var cols = MounterGetColumnWidths(width);
	var nameColWidth = cols[1];
	var fsColWidth = cols[2];
	var statusColWidth = cols[3];
	var sizeColWidth = cols[4];

	var visibleVolumes = int(height / VOLUMEROWHEIGHT);

	for volumeRow = 1 to visibleVolumes
	{
		var idx = mounterScrollOffset + volumeRow - 1;
		var baseY = y + (volumeRow - 1) * VOLUMEROWHEIGHT;

		MounterDrawVolumeRow(x, baseY, width, nameColWidth, fsColWidth, statusColWidth, sizeColWidth, idx);
	}

	var painted = visibleVolumes * VOLUMEROWHEIGHT;

	if painted < height
	{
		BFClearRegion(x, y + painted, width, height - painted);
	}
}

#@ <MounterRedrawVolumeRow(idx)>
#@ Redraws the volume row for entry ''idx'' in place if it is within the visible
#@ viewport.

func MounterRedrawVolumeRow(idx)
{
	var region = GetMounterListRegion(mounterScreenWidth, mounterScreenHeight);

	var visibleVolumes = int(region[5] / VOLUMEROWHEIGHT);

	var volumeRow = idx - mounterScrollOffset + 1;

	if volumeRow < 1 or volumeRow > visibleVolumes { return; }

	var cols = MounterGetColumnWidths(region[4]);

	var baseY = region[3] + (volumeRow - 1) * VOLUMEROWHEIGHT;

	MounterDrawVolumeRow(region[1], baseY, region[4], cols[1], cols[2], cols[3], cols[4], idx);
}

#@ <MounterDrawSidebarRow(x, y, width, idx, isFirst)>
#@ Draws the sidebar entry ''idx'' at ''y'', either a section header or a disk.
#@ ''isFirst'' is true for the topmost drawn entry.

func MounterDrawSidebarRow(x, y, width, idx, isFirst)
{
	var rowWidth = width - 1;
	var textWidth = rowWidth - 2;

	var emptyRow = BFPadText("", rowWidth, BFALIGNLEFT);

	var entry = mounterDisks[idx];

	if not IsDeviceEntry(entry)
	{
		var sectionText = BFClipText(" ── " + entry["label"] + " ──", rowWidth);
		var headerY = y;

		if not isFirst
		{
			BFDrawText(x, y, emptyRow);

			headerY = y + 1;
		}

		SetAttribute(COLORBOLD);
		BFDrawText(x, headerY, BFPadText(sectionText, rowWidth, BFALIGNLEFT));
		SetAttribute(COLORRESET);

		BFDrawText(x, headerY + 1, emptyRow);

		return;
	}

	var isSelected = idx == mounterSelectedDisk and mounterFocusPanel == FOCUSSIDEBAR;

	var indicator = "  ";

	if isSelected { indicator = "> "; }

	var title = BFPadText(indicator + BFClipText(SidebarDiskTitle(entry), textWidth),
		rowWidth, BFALIGNLEFT);

	var detail = BFPadText(indicator + BFClipText(SidebarDiskDetail(entry), textWidth),
		rowWidth, BFALIGNLEFT);

	if isSelected
	{
		SetAttribute(COLORBLACK);
		SetAttribute(COLORBOLD);
		SetAttribute(COLORBGWHITE);

		BFDrawText(x, y, title);
		BFDrawText(x, y + 1, detail);

		SetAttribute(COLORRESET);
	}
	elseif entry["name"] == mounterActiveDisk
	{
		SetAttribute(COLORWHITE);
		SetAttribute(COLORBOLD);
		SetBGColorRGB(DFNCOLORACCENT["r"], DFNCOLORACCENT["g"], DFNCOLORACCENT["b"]);

		BFDrawText(x, y, title);
		BFDrawText(x, y + 1, detail);

		SetAttribute(COLORRESET);
	}
	else
	{
		SetAttribute(COLORBOLD);
		BFDrawText(x, y, title);
		SetAttribute(COLORRESET);

		SetFGColor256(DFNCOLORDIM);
		BFDrawText(x, y + 1, detail);
		SetAttribute(COLORRESET);
	}
}

#@ <MounterDrawSidebar(x, y, width, height)>
#@ Draws the disk sidebar at position ''x'' and ''y''.

func MounterDrawSidebar(x, y, width, height)
{
	var lastY = y + height - 1;
	var rowY = y;

	for idx = mounterDiskScrollOffset to MounterLastDrawableDisk(mounterDiskScrollOffset)
	{
		var isFirst = idx == mounterDiskScrollOffset;

		MounterDrawSidebarRow(x, rowY, width, idx, isFirst);

		rowY = rowY + MounterSidebarEntryHeight(mounterDisks[idx], isFirst);
	}

	BFClearRegion(x, rowY, width - 1, lastY - rowY + 1);
}

#@ <MounterDrawVerticalSeparator(x, y, height)>
#@ Draws the vertical line between the sidebar and the volume list.

func MounterDrawVerticalSeparator(x, y, height)
{
	SetFGColor256(DFNCOLORDIM);
	BFDrawVLine(x, y, height, "│");
	SetAttribute(COLORRESET);
}

#@ <MounterBottomReserve()>
#@ Returns the number of rows reserved at the bottom of the screen. If not
#@ ''KEYBINDSBARHEIGHT'' then ''1'' is returned for the ". binds" hint.

func MounterBottomReserve()
{
	if mounterShowKeybinds { return KEYBINDSBARHEIGHT; }

	return 1;
}

#@ <MounterDrawBottom()>
#@ Decides if the keybinds bar or the ". binds" hint should be drawn and draws
#@ them.

func MounterDrawBottom()
{
	if mounterShowKeybinds { MounterDrawKeybindsBar(); }
	else { MounterDrawBottomHint(); }
}

#@ <MounterDrawBottomHint()>
#@ Draws the ". binds" hint.

func MounterDrawBottomHint()
{
	BFClearRegion(1, mounterScreenHeight, SIDEBARWIDTH - 1, 1);

	SetFGColor256(DFNCOLORDIM);
	BFDrawText(2, mounterScreenHeight, ". binds");
	SetAttribute(COLORRESET);
}

#@ <MounterDrawKeybindsBar()>
#@ Draws the keybinds help bar at the bottom of the screen.

func MounterDrawKeybindsBar()
{
	var rows = [];

	append(rows, []);

	if mounterFocusPanel == FOCUSSIDEBAR
	{
		append(rows, [
				["↑↓", "Navigate"],
				["→ Enter", "Go"],
				["Tab", "Volumes"],
				["i", "Info"],
				["e", "Eject"],
				["r", "Refresh"],
				["Esc", "Quit"]
			]);
	}
	else
	{
		append(rows, [
				["↑↓", "Navigate"],
				["←", "Unmount/Lock"],
				["→", "Mount/Unlock/Open"],
				["Tab", "Disks"],
				["i", "Info"],
				["r", "Refresh"],
				["Esc", "Quit"]
			]);
	}

	append(rows, []);

	BFKeybindsBar(1, mounterScreenHeight - KEYBINDSBARHEIGHT + 1, mounterScreenWidth, rows);
}

#@ <MounterDrawScreen()>
#@ Draws the complete screen.

func MounterDrawScreen()
{
	var sidebar = GetMounterSidebarRegion(mounterScreenHeight);
	var panel = GetMounterRegion(mounterScreenWidth, mounterScreenHeight);
	var region = GetMounterListRegion(mounterScreenWidth, mounterScreenHeight);

	var separatorHeight = mounterScreenHeight;

	if mounterShowKeybinds
	{
		separatorHeight = mounterScreenHeight - KEYBINDSBARHEIGHT;
	}

	MounterDrawSidebar(sidebar[1], sidebar[2], sidebar[3], sidebar[4]);
	MounterDrawVerticalSeparator(SIDEBARWIDTH, 1, separatorHeight);

	MounterDrawTitleBar(panel[1], panel[2], panel[3]);

	if len(mounterVolumes) == 0
	{
		BFClearRegion(region[1], region[2], region[4], LISTHEADERHEIGHT);
	}
	else
	{
		MounterDrawHeader(region[1], region[2], region[4]);
	}

	MounterDrawVolumeList(region[1], region[3], region[4], region[5]);
	MounterDrawBottom();
}
