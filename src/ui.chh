#!/usr/bin/chippy
#
# dfn-mounter - ui.chh
#

#@ <DeviceStatusText(dev, devices)>
#@ Returns the status string used in the STATUS column and the device info dialog.

func DeviceStatusText(dev, devices)
{
	if IsLuks(dev)
	{
		if IsLuksUnlocked(dev, devices) { return "[LUKS unlocked]"; }

		return "[LUKS locked]";
	}

	if IsSwap(dev) { return "[swap]"; }

	if IsMounted(dev) { return dev["mountpoint"]; }

	if dev["fstype"] == "LVM2_member" { return "[LVM]"; }

	return "[unmounted]";
}

#@ <SerialTail(serial)>
#@ Returns the last 6 characters of the ''serial'' number, prefixed with "...".
#@ Returns the whole serial if it is 6 characters or shorter.

func SerialTail(serial)
{
	if serial == "" { return ""; }

	var serialLen = len(serial);

	if serialLen <= 6 { return serial; }

	return "..." + Right(serial, 6);
}

#@ <DiskShortLabel(dev)>
#@ Returns a label for the parent disk: ''"<model> (...SerialTail(serial))"'' when
#@ both are available, otherwise the disk name path.

func DiskShortLabel(dev)
{
	var model = dev["model"];
	var serial = dev["serial"];
	var disk = dev["disk"];

	var label = "";

	if model != "" { label = model; }
	else { label = "/dev/" + disk; }

	var tail = SerialTail(serial);

	if tail != "" { label = label + " (" + tail + ")"; }

	return label;
}

#@ <DeviceTypeDescription(dev)>
#@ Returns a description of a ''dev''ice's role.

func DeviceTypeDescription(dev)
{
	var devType = dev["type"];
	var fstype = dev["fstype"];

	if devType == "part" and fstype == "crypto_LUKS"
	{
		return "LUKS container";
	}
	if devType == "part" { return "Partition"; }
	if devType == "crypt" and fstype == "LVM2_member"
	{
		return "LUKS volume (LVM PV)";
	}
	if devType == "crypt" { return "LUKS volume"; }
	if devType == "lvm" { return "LVM logical volume"; }

	return devType;
}

#@ <DeviceDisplayName(dev)>
#@ Returns the display name for a ''dev''ice.

func DeviceDisplayName(dev)
{
	var label = dev["label"];
	var model = dev["model"];
	var name = dev["name"];
	var size = dev["size"];
	var serial = dev["serial"];

	var tailPart = "";

	# Last 3 chars of serial
	if serial != ""
	{
		var serialLen = len(serial);
		var tail = serial;

		if serialLen > 3 { tail = Right(serial, 3); }

		tailPart = " [" + tail + "]";
	}

	# No label?
	if label != "" { return label + tailPart + " (" + name + ")"; }

	# Fall back to model + size
	if model != "" { return size + " " + model + tailPart + " (" + name + ")"; }

	# Fall back to name + size
	return name + tailPart + " (" + size + ")";
}

#@ <MounterGetColumnWidths(width)>
#@ Returns column widths as a list:
#@ ''[nameColWidth, fsColWidth, statusColWidth, sizeColWidth]''.

func MounterGetColumnWidths(width)
{
	var sizeColWidth = 10;
	var fsColWidth = 14;
	var statusColWidth = 28;
	var nameColWidth = width - fsColWidth - statusColWidth - sizeColWidth - 3;

	return [nameColWidth, fsColWidth, statusColWidth, sizeColWidth];
}

#@ <GetMounterListRegion()>
#@ Returns the region of the device list: ''[x, headerY, listY, width, height]''.

func GetMounterListRegion()
{
	var x = 2;
	var headerY = 1;
	var listY = 2;
	var width = mounterScreenWidth - 2;
	var height = mounterScreenHeight - MounterBottomReserve() - 2;

	return [x, headerY, listY, width, height];
}

#@ <MounterDrawHeader(x, y, width)>
#@ Draws the column header row.

func MounterDrawHeader(x, y, width)
{
	var cols = MounterGetColumnWidths(width);
	var nameColWidth = cols[1];
	var fsColWidth = cols[2];
	var statusColWidth = cols[3];
	var sizeColWidth = cols[4];

	var nameHeader = BFPadText("  DEVICE", nameColWidth, BFALIGNLEFT);
	var fsHeader = BFPadText("FSTYPE", fsColWidth, BFALIGNLEFT);
	var statusHeader = BFPadText("STATUS", statusColWidth, BFALIGNRIGHT);
	var sizeHeader = BFPadText("SIZE", sizeColWidth, BFALIGNRIGHT);

	var header = nameHeader + " " + fsHeader + " " + statusHeader + " " + sizeHeader;

	SetAttribute(COLORBOLD);
	BFDrawText(x, y, header);
	SetAttribute(COLORRESET);
}

#@ <MounterDrawDeviceRow(x, baseY, width, nameColWidth, fsColWidth, statusColWidth, sizeColWidth, idx)>
#@ Draws one device list row at position ''baseY''.

func MounterDrawDeviceRow(x, baseY, width, nameColWidth, fsColWidth, statusColWidth, sizeColWidth, idx)
{
	var emptyRow = BFPadText("", width, BFALIGNLEFT);

	if idx >= 1 and idx <= len(mounterDevices) and not IsDeviceEntry(mounterDevices[idx])
	{
		var sectionText = BFClipText("── " + mounterDevices[idx]["label"] + " ──", width);

		sectionText = BFPadText(sectionText, width, BFALIGNLEFT);

		SetAttribute(COLORBOLD);
		BFDrawText(x, baseY, sectionText);
		SetAttribute(COLORRESET);
		BFDrawText(x, baseY + 1, emptyRow);
	}
	elseif idx >= 1 and idx <= len(mounterDevices)
	{
		var dev = mounterDevices[idx];
		var displayName = DeviceDisplayName(dev);
		var size = dev["size"];
		var isSelected = idx == mounterSelectedIndex;

		if isSelected
		{
			SetAttribute(COLORBLACK);
			SetAttribute(COLORBOLD);
			SetAttribute(COLORBGWHITE);
		}
		elseif IsMounted(dev)
		{
			SetAttribute(COLORBOLD);
			SetAttribute(COLORCYAN);
		}
		elseif IsLuks(dev)
		{
			SetAttribute(COLORBOLD);
			SetAttribute(COLORMAGENTA);
		}

		var status = DeviceStatusText(dev, mounterDevices);

		# Optional transport tag in front of the name
		var tag = "";

		if dev["transport"] == "usb" { tag = "[USB] "; }

		# Build columns
		var nameText = "  " + tag + displayName;
		nameText = BFClipText(nameText, nameColWidth);
		nameText = BFPadText(nameText, nameColWidth, BFALIGNLEFT);

		var fsText = BFClipText(dev["fstype"], fsColWidth);
		fsText = BFPadText(fsText, fsColWidth, BFALIGNLEFT);

		var sizeText = BFPadText(size, sizeColWidth, BFALIGNRIGHT);

		var statusText = BFClipText(status, statusColWidth);
		statusText = BFPadText(statusText, statusColWidth, BFALIGNRIGHT);

		var rowText = nameText + " " + fsText + " " + statusText + " " + sizeText;

		BFDrawText(x, baseY, rowText);

		# Spacing
		BFDrawText(x, baseY + 1, emptyRow);
	}
	else
	{
		BFDrawText(x, baseY, emptyRow);
		BFDrawText(x, baseY + 1, emptyRow);
	}

	SetAttribute(COLORRESET);
}

#@ <MounterDrawDeviceList(x, y, width, height)>
#@ Draws the device list.

func MounterDrawDeviceList(x, y, width, height)
{
	var cols = MounterGetColumnWidths(width);
	var nameColWidth = cols[1];
	var fsColWidth = cols[2];
	var statusColWidth = cols[3];
	var sizeColWidth = cols[4];

	var visibleDevices = int(height / FILEROWHEIGHT);

	for devRow = 1 to visibleDevices
	{
		var idx = mounterScrollOffset + devRow - 1;
		var baseY = y + (devRow - 1) * FILEROWHEIGHT;

		MounterDrawDeviceRow(x, baseY, width, nameColWidth, fsColWidth, statusColWidth, sizeColWidth, idx);
	}
}

#@ <MounterRedrawDeviceRow(idx)>
#@ Redraws the device row for entry ''idx'' in place if it is within the visible
#@ viewport.

func MounterRedrawDeviceRow(idx)
{
	var region = GetMounterListRegion();

	var visibleDevices = int(region[5] / FILEROWHEIGHT);

	var devRow = idx - mounterScrollOffset + 1;

	if devRow < 1 or devRow > visibleDevices { return; }

	var cols = MounterGetColumnWidths(region[4]);

	var baseY = region[3] + (devRow - 1) * FILEROWHEIGHT;

	MounterDrawDeviceRow(region[1], baseY, region[4], cols[1], cols[2], cols[3], cols[4], idx);
}

#@ <MounterBottomReserve()>
#@ Returns the number of rows reserved at the bottom of the screen. If not
#@ ''KEYBINDSBARHEIGHT'' then ''1'' is returned for the ". binds" hint.

func MounterBottomReserve()
{
	if mounterShowKeybinds { return KEYBINDSBARHEIGHT; }

	return 1;
}

#@ <MounterDrawBottom()>
#@ Decides if the keybinds bar or the ". binds" hint should be drawn and draws
#@ them.

func MounterDrawBottom()
{
	if mounterShowKeybinds { MounterDrawKeybindsBar(); }
	else { MounterDrawBottomHint(); }
}

#@ <MounterDrawScreen()>
#@ Draws the full screen.

func MounterDrawScreen()
{
	var region = GetMounterListRegion();

	MounterDrawHeader(region[1], region[2], region[4]);
	MounterDrawDeviceList(region[1], region[3], region[4], region[5]);
	MounterDrawBottom();
}

#@ <MounterDrawBottomHint()>
#@ Draws the ". binds" hint.

func MounterDrawBottomHint()
{
	BFClearRegion(1, mounterScreenHeight, 12, 1);

	SetFGColor256(DFNCOLORDIM);
	BFDrawText(2, mounterScreenHeight, ". binds");
	SetAttribute(COLORRESET);
}

#@ <MounterDrawKeybindsBar()>
#@ Draws the keybinds help bar at the bottom of the screen.

func MounterDrawKeybindsBar()
{
	var rows = [];

	append(rows, []);
	append(rows, [
			["↑↓", "Navigate"],
			["←", "Unmount/Lock"],
			["→", "Mount/Unlock"],
			["e", "Eject"],
			["i", "Info"],
			["r", "Refresh"],
			["Esc", "Quit"]
		]);
	append(rows, []);

	BFKeybindsBar(1, mounterScreenHeight - KEYBINDSBARHEIGHT + 1, mounterScreenWidth, rows);
}
