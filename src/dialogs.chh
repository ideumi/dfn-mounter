#!/usr/bin/chippy
#
# dfn-mounter - dialogs.chh
#

#@ <GetMounterRegion(screenWidth, screenHeight)>
#@ Returns the mounter region: ''[x, y, width, height]''.

func GetMounterRegion(screenWidth, screenHeight)
{
	var x = 1;
	var y = 1;
	var width = screenWidth;
	var height = screenHeight - MounterBottomReserve();

	return [x, y, width, height];
}

#@ <CloseMounterDialog()>
#@ Hides the cursor and clears the in-dialog flag.

func CloseMounterDialog()
{
	HideCursor();
	ExitMounterDialog();
}

#@ <DrawInfoRow(contentX, row, labelWidth, valueWidth, label, value)>
#@ Draws one label / value row of the device info dialog.

func DrawInfoRow(contentX, row, labelWidth, valueWidth, label, value)
{
	BFDrawText(contentX, row,
		BFPadText(label, labelWidth, BFALIGNLEFT) + BFClipText(value, valueWidth));
}

#@ <MounterShowDebug()>
#@ Renders a small debug dialog where versions can be checked.

func MounterShowDebug()
{
	EnterMounterDialog();

	BFShowMessage(GetMounterRegion(mounterScreenWidth, mounterScreenHeight),
		DIALOGWIDTH,
		"Debug",
		"This is " + PROGRAMNAME + " V-" + VERSION + "\nusing boxflinger V-" +
		BFVERSION + "\n\nCopyright (c) 2026 ideumi", COLORRESET);

	CloseMounterDialog();
}

#@ <MounterShowConfirm(message)>
#@ Shows a centered confirmation dialog on the full screen.

func MounterShowConfirm(message)
{
	EnterMounterDialog();

	var region = GetMounterRegion(mounterScreenWidth, mounterScreenHeight);

	var result = BFShowConfirm(region, DIALOGWIDTH, "Confirm", message, true);

	CloseMounterDialog();

	return result;
}

#@ <MounterShowDeviceInfo(dev)>
#@ Shows a centered info dialog with all relevant metadata for ''dev''ice.

func MounterShowDeviceInfo(dev)
{
	EnterMounterDialog();

	var width = DIALOGWIDTH;
	var height = 14;
	var labelWidth = 9;

	var region = GetMounterRegion(mounterScreenWidth, mounterScreenHeight);
	var origin = BFCenterRect(region, width, height);
	var x = origin[1];
	var y = origin[2];

	BFClearRegion(x, y, width, height);
	BFDrawFrame(x, y, width, height, "Device Info", BFBOXROUNDED);

	var contentX = x + 2;
	var contentWidth = width - 4;
	var valueWidth = contentWidth - labelWidth;
	var row = y + 1;

	# Name
	DrawInfoRow(contentX, row, labelWidth, valueWidth, "Name:", DeviceDisplayName(dev));
	row = row + 1;

	# Path
	DrawInfoRow(contentX, row, labelWidth, valueWidth, "Path:", DevicePath(dev));
	row = row + 1;

	# Type
	DrawInfoRow(contentX, row, labelWidth, valueWidth, "Type:", DeviceTypeDescription(dev));
	row = row + 1;

	# Filesystem
	DrawInfoRow(contentX, row, labelWidth, valueWidth, "FS:",
		DefaultIfEmpty(dev["fstype"], "(none)"));
	row = row + 1;

	# Size
	BFDrawText(contentX, row, BFPadText("Size:", labelWidth, BFALIGNLEFT) + dev["size"]);
	row = row + 1;

	# Label
	DrawInfoRow(contentX, row, labelWidth, valueWidth, "Label:",
		DefaultIfEmpty(dev["label"], "(none)"));
	row = row + 1;

	# UUID
	DrawInfoRow(contentX, row, labelWidth, valueWidth, "UUID:",
		DefaultIfEmpty(dev["uuid"], "(none)"));
	row = row + 1;

	# Status
	DrawInfoRow(contentX, row, labelWidth, valueWidth, "Status:",
		DeviceStatusText(dev, mounterDevices));
	row = row + 1;

	# Drive
	var driveStr = dev["model"];

	if driveStr == "" { driveStr = "/dev/" + dev["disk"]; }

	var tagList = [];

	if dev["transport"] != "" { append(tagList, dev["transport"]); }
	if dev["removable"] { append(tagList, "removable"); }

	if len(tagList) > 0
	{
		driveStr = driveStr + " [" + join(tagList, ", ") + "]";
	}

	DrawInfoRow(contentX, row, labelWidth, valueWidth, "Drive:", driveStr);
	row = row + 1;

	# Serial
	DrawInfoRow(contentX, row, labelWidth, valueWidth, "Serial:",
		DefaultIfEmpty(dev["serial"], "(unknown)"));
	row = row + 2;

	BFDrawText(contentX, row, "Press any key...");

	getch();

	CloseMounterDialog();
}

#@ <MounterShowError(message)>
#@ Shows a centered error dialog on the full screen.

func MounterShowError(message)
{
	EnterMounterDialog();

	var region = GetMounterRegion(mounterScreenWidth, mounterScreenHeight);

	BFShowMessage(region, DIALOGWIDTH, "Error", message, COLORRED);

	CloseMounterDialog();
}
