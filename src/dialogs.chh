#!/usr/bin/chippy
#
# dfn-mounter - dialogs.chh
#

#@ <EnterMounterDialog()>
#@ Sets the in-dialog flag and tells the winsize actor to suppress repaints until
#@ the dialog returns.

func EnterMounterDialog()
{
	mounterInDialog = true;

	if not iserr(mounterWinsizeHandle)
	{
		send(mounterWinsizeHandle, MounterCurrentState());
	}
}

#@ <ExitMounterDialog()>
#@ Clears the in-dialog flag.

func ExitMounterDialog()
{
	mounterInDialog = false;

	if not iserr(mounterWinsizeHandle)
	{
		send(mounterWinsizeHandle, MounterCurrentState());
	}
}

#@ <CloseMounterDialog()>
#@ Hides the cursor and leaves dialog mode.

func CloseMounterDialog()
{
	HideCursor();
	ExitMounterDialog();
}

#@ <MounterShowInfoDialog(title, labelWidth, rows)>
#@ Shows an info dialog titled ''title'' that displays ''rows'' of label/value
#@ maps with labels padded to ''labelWidth''.
#@
#@ Row map fields:
#@ - ''"label"'' (String): the field name, drawn left-aligned at ''labelWidth''
#@ - ''"value"'' (String): the field value, drawn right of the label

func MounterShowInfoDialog(title, labelWidth, rows)
{
	EnterMounterDialog();

	var width = DIALOGWIDTH;
	var height = len(rows) + 4;

	var region = GetMounterRegion(mounterScreenWidth, mounterScreenHeight);
	var origin = BFCenterRect(region, width, height);
	var x = origin["x"];
	var y = origin["y"];

	BFClearRegion(x, y, width, height);
	BFDrawFrame(x, y, width, height, title, BFBOXROUNDED);

	var contentX = x + 2;
	var valueWidth = width - 4 - labelWidth;

	for rowIndex = 1 to len(rows)
	{
		var row = rows[rowIndex];

		BFDrawText(contentX, y + rowIndex,
			BFPadText(row["label"], labelWidth, BFALIGNLEFT) +
			BFClipText(row["value"], valueWidth));
	}

	BFDrawText(contentX, y + len(rows) + 2, "Press any key...");

	getch();

	CloseMounterDialog();
}

#@ <MounterShowAbout()>
#@ Shows the about dialog.

func MounterShowAbout()
{
	EnterMounterDialog();

	var width = DIALOGWIDTH;
	var height = 13;

	var region = GetMounterRegion(mounterScreenWidth, mounterScreenHeight);
	var origin = BFCenterRect(region, width, height);
	var x = origin["x"];
	var y = origin["y"];

	BFClearRegion(x, y, width, height);
	BFDrawFrame(x, y, width, height, "About", BFBOXROUNDED);

	var contentX = x + 2;
	var contentWidth = width - 4;

	var title = PROGRAMNAME + " V-" + VERSION;
	title = BFPadText(title, contentWidth, BFALIGNCENTER);

	var desc = "A simple TUI disk mounter";
	desc = BFPadText(desc, contentWidth, BFALIGNCENTER);

	var quote = "HEY EVERY !! W4NNA MOUNT A [[BIG DISK]] ??";
	quote = BFPadText(quote, contentWidth, BFALIGNCENTER);

	var copyright = "Copyright (c) 2026 ideumi";
	copyright = BFPadText(copyright, contentWidth, BFALIGNCENTER);

	var bfver = "using boxflinger V-" + BFVERSION;
	bfver = BFPadText(bfver, contentWidth, BFALIGNCENTER);

	SetAttribute(COLORBOLD);
	BFDrawText(contentX, y + 2, title);
	SetAttribute(COLORRESET);
	BFDrawText(contentX, y + 3, bfver);
	BFDrawText(contentX, y + 5, desc);
	BFDrawText(contentX, y + 7, quote);
	BFDrawText(contentX, y + 9, copyright);
	BFDrawText(contentX, y + 11, "Press any key...");

	getch();

	CloseMounterDialog();
}

#@ <MounterShowConfirm(message)>
#@ Shows a centered Yes/No confirmation dialog with Yes preselected. Returns the
#@ choice, or ''err'' when the dialog is cancelled.

func MounterShowConfirm(message)
{
	EnterMounterDialog();

	var region = GetMounterRegion(mounterScreenWidth, mounterScreenHeight);

	var result = BFShowConfirm(region, DIALOGWIDTH, "Confirm", message, true);

	CloseMounterDialog();

	return result;
}

#@ <MounterConfirmExit()>
#@ The exit confirmation dialog.

func MounterConfirmExit()
{
	var confirmed = MounterShowConfirm("Do you really want to exit?");

	if not iserr(confirmed) and confirmed { return true; }

	ClearScreen();

	return false;
}

#@ <MounterShowVolumeInfo(volume)>
#@ Shows an info dialog with all relevant metadata for a ''volume'' entry.

func MounterShowVolumeInfo(volume)
{
	var driveStr = volume["model"];

	if driveStr == "" { driveStr = "/dev/" + volume["disk"]; }

	var tagList = [];

	if volume["transport"] != "" { append(tagList, volume["transport"]); }
	if volume["removable"] { append(tagList, "removable"); }

	if len(tagList) > 0
	{
		driveStr = driveStr + " [" + join(tagList, ", ") + "]";
	}

	MounterShowInfoDialog("Volume Info", 9, [
			m["label": "Name:", "value": DeviceDisplayName(volume)],
			m["label": "Path:", "value": DevicePath(volume)],
			m["label": "Type:", "value": DeviceTypeDescription(volume)],
			m["label": "FS:", "value": DefaultIfEmpty(volume["fstype"], "(none)")],
			m["label": "Size:", "value": volume["size"]],
			m["label": "Label:", "value": DefaultIfEmpty(volume["label"], "(none)")],
			m["label": "UUID:", "value": DefaultIfEmpty(volume["uuid"], "(none)")],
			m["label": "Status:", "value": DeviceStatusText(volume, mounterDevices)],
			m["label": "Drive:", "value": driveStr],
			m["label": "Serial:", "value": DefaultIfEmpty(volume["serial"], "(unknown)")]
		]);
}

#@ <MounterShowDiskInfo(disk)>
#@ Shows an info dialog with all relevant metadata for a sidebar ''disk'' entry.

func MounterShowDiskInfo(disk)
{
	var removable = "no";

	if disk["removable"] { removable = "yes"; }

	MounterShowInfoDialog("Disk Info", 11, [
			m["label": "Model:", "value": DefaultIfEmpty(disk["model"], "(unknown)")],
			m["label": "Path:", "value": "/dev/" + disk["name"]],
			m["label": "Size:", "value": disk["size"]],
			m["label": "Serial:", "value": DefaultIfEmpty(disk["serial"], "(unknown)")],
			m["label": "Transport:", "value": DefaultIfEmpty(disk["transport"], "(unknown)")],
			m["label": "Removable:", "value": removable],
			m["label": "Volumes:", "value": str(len(VolumesForDisk(mounterDevices, disk["name"])))]
		]);
}

#@ <MounterShowError(message)>
#@ Displays an error message dialog.

func MounterShowError(message)
{
	EnterMounterDialog();

	var region = GetMounterRegion(mounterScreenWidth, mounterScreenHeight);

	BFShowMessage(region, DIALOGWIDTH, "Error", message, COLORRED);

	CloseMounterDialog();
}
