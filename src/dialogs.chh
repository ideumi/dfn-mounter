#!/usr/bin/chippy
#
# dfn-mounter - dialogs.chh
#

#@ <EnterMounterDialog()>
#@ Sets the in-dialog flag and tells the winsize actor to suppress repaints
#@ until the dialog returns.

func EnterMounterDialog()
{
	mounterInDialog = true;

	if not iserr(mounterWinsizeHandle)
	{
		send(mounterWinsizeHandle, MounterCurrentState());
	}
}

#@ <ExitMounterDialog()>
#@ Clears the in-dialog flag.

func ExitMounterDialog()
{
	mounterInDialog = false;

	if not iserr(mounterWinsizeHandle)
	{
		send(mounterWinsizeHandle, MounterCurrentState());
	}
}

#@ <CloseMounterDialog()>
#@ Hides the cursor and leaves dialog mode.

func CloseMounterDialog()
{
	HideCursor();
	ExitMounterDialog();
}

#@ <MounterShowInfoDialog(title, labelWidth, rows)>
#@ Shows an info dialog titled ''title'' that displays ''rows'' of ''[label, value]''
#@ with labels padded to ''labelWidth''.

func MounterShowInfoDialog(title, labelWidth, rows)
{
	EnterMounterDialog();

	var width = DIALOGWIDTH;
	var height = len(rows) + 4;

	var region = GetMounterRegion(mounterScreenWidth, mounterScreenHeight);
	var origin = BFCenterRect(region, width, height);
	var x = origin[1];
	var y = origin[2];

	BFClearRegion(x, y, width, height);
	BFDrawFrame(x, y, width, height, title, BFBOXROUNDED);

	var contentX = x + 2;
	var valueWidth = width - 4 - labelWidth;

	for rowIndex = 1 to len(rows)
	{
		var row = rows[rowIndex];

		BFDrawText(contentX, y + rowIndex,
			BFPadText(row[1], labelWidth, BFALIGNLEFT) + BFClipText(row[2], valueWidth));
	}

	BFDrawText(contentX, y + len(rows) + 2, "Press any key...");

	getch();

	CloseMounterDialog();
}

#@ <MounterShowDebug()>
#@ Renders a small debug dialog where versions can be checked.

func MounterShowDebug()
{
	EnterMounterDialog();

	BFShowMessage(GetMounterRegion(mounterScreenWidth, mounterScreenHeight),
		DIALOGWIDTH,
		"Debug",
		"This is " + PROGRAMNAME + " V-" + VERSION + "\nusing boxflinger V-" +
		BFVERSION + "\n\nCopyright (c) 2026 ideumi", COLORRESET);

	CloseMounterDialog();
}

#@ <MounterShowConfirm(message)>
#@ Shows a centered Yes/No confirmation dialog with Yes preselected. Returns the
#@ choice, or ''err'' when the dialog is cancelled.

func MounterShowConfirm(message)
{
	EnterMounterDialog();

	var region = GetMounterRegion(mounterScreenWidth, mounterScreenHeight);

	var result = BFShowConfirm(region, DIALOGWIDTH, "Confirm", message, true);

	CloseMounterDialog();

	return result;
}

#@ <MounterConfirmExit()>
#@ The exit confirmation dialog.

func MounterConfirmExit()
{
	var confirmed = MounterShowConfirm("Do you really want to exit?");

	if not iserr(confirmed) and confirmed { return true; }

	ClearScreen();

	return false;
}

#@ <MounterShowVolumeInfo(volume)>
#@ Shows an info dialog with all relevant metadata for a ''volume'' entry.

func MounterShowVolumeInfo(volume)
{
	var driveStr = volume["model"];

	if driveStr == "" { driveStr = "/dev/" + volume["disk"]; }

	var tagList = [];

	if volume["transport"] != "" { append(tagList, volume["transport"]); }
	if volume["removable"] { append(tagList, "removable"); }

	if len(tagList) > 0
	{
		driveStr = driveStr + " [" + join(tagList, ", ") + "]";
	}

	MounterShowInfoDialog("Volume Info", 9, [
			["Name:", DeviceDisplayName(volume)],
			["Path:", DevicePath(volume)],
			["Type:", DeviceTypeDescription(volume)],
			["FS:", DefaultIfEmpty(volume["fstype"], "(none)")],
			["Size:", volume["size"]],
			["Label:", DefaultIfEmpty(volume["label"], "(none)")],
			["UUID:", DefaultIfEmpty(volume["uuid"], "(none)")],
			["Status:", DeviceStatusText(volume, mounterDevices)],
			["Drive:", driveStr],
			["Serial:", DefaultIfEmpty(volume["serial"], "(unknown)")]
		]);
}

#@ <MounterShowDiskInfo(disk)>
#@ Shows an info dialog with all relevant metadata for a sidebar ''disk'' entry.

func MounterShowDiskInfo(disk)
{
	var removable = "no";

	if disk["removable"] { removable = "yes"; }

	MounterShowInfoDialog("Disk Info", 11, [
			["Model:", DefaultIfEmpty(disk["model"], "(unknown)")],
			["Path:", "/dev/" + disk["name"]],
			["Size:", disk["size"]],
			["Serial:", DefaultIfEmpty(disk["serial"], "(unknown)")],
			["Transport:", DefaultIfEmpty(disk["transport"], "(unknown)")],
			["Removable:", removable],
			["Volumes:", str(len(VolumesForDisk(mounterDevices, disk["name"])))]
		]);
}

#@ <MounterShowError(message)>
#@ Displays an error message dialog.

func MounterShowError(message)
{
	EnterMounterDialog();

	var region = GetMounterRegion(mounterScreenWidth, mounterScreenHeight);

	BFShowMessage(region, DIALOGWIDTH, "Error", message, COLORRED);

	CloseMounterDialog();
}
