var BFPACKEDSINGLETR = pack("┐");
var BFPACKEDSINGLEBL = pack("└");
var BFPACKEDSINGLEBR = pack("┘");
var BFPACKEDSINGLEH = pack("─");
var BFPACKEDSINGLEV = pack("│");

#@ <BFBOXDOUBLE>
#@ (2025-09-28)
#@ Double-line box border style

