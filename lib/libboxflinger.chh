var BFPACKEDDOUBLETL = pack("╔");
var BFPACKEDDOUBLETR = pack("╗");
var BFPACKEDDOUBLEBL = pack("╚");
var BFPACKEDDOUBLEBR = pack("╝");
var BFPACKEDDOUBLEH = pack("═");
var BFPACKEDDOUBLEV = pack("║");

#@ <BFBOXROUNDED>
#@ (2025-09-28)
#@ Rounded corner box border style

